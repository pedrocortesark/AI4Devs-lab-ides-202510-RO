# ============================================
# LTI - Applicant Tracking System
# Environment Variables Template
# ============================================

# --------------------------------------------
# DATABASE CONFIGURATION
# --------------------------------------------
# PostgreSQL connection details
DB_USER=LTIdbUser
DB_PASSWORD=D1ymf8wyQEGthFR1E9xhCq
DB_NAME=LTIdb
DB_HOST=localhost
DB_PORT=5432

# Prisma connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# --------------------------------------------
# SERVER CONFIGURATION
# --------------------------------------------
# Backend server port
PORT=3010

# Node environment (development, production, test)
NODE_ENV=development

# --------------------------------------------
# CORS CONFIGURATION
# --------------------------------------------
# Allowed frontend origin
CORS_ORIGIN=http://localhost:3000

# --------------------------------------------
# FILE UPLOAD CONFIGURATION
# --------------------------------------------
# Maximum file size in bytes (10MB)
MAX_FILE_SIZE=10485760

# Upload directory path (relative to backend root)
UPLOAD_DIR=./uploads

# --------------------------------------------
# LOGGING CONFIGURATION
# --------------------------------------------
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable PII redaction in logs (true/false)
LOG_REDACT_PII=true

# --------------------------------------------
# SECURITY CONFIGURATION
# --------------------------------------------
# JWT Secret (for future authentication implementation)
# JWT_SECRET=your-secret-key-here
# JWT_EXPIRES_IN=7d

# --------------------------------------------
# FRONTEND CONFIGURATION
# --------------------------------------------
# API base URL for frontend
REACT_APP_API_URL=http://localhost:3010/api
