// Prisma Schema for LTI ATS
// PostgreSQL 16.x + Prisma 5.x

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Health check model (minimal for testing DB connection)
model HealthCheck {
  id        String   @id @default(uuid())
  status    String
  timestamp DateTime @default(now())

  @@map("health_checks")
}